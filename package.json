{
  "name": "lumacord",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "audit:release": "node scripts/audit-release.mjs",
    "media:capture": "node scripts/capture-media.mjs",
    "test:production": "node scripts/verify-production.mjs",
    "audit": "npm run audit:release"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0"
  },
  "description": "Cinematic lamp-powered login UI with a backend-agnostic TypeScript integration API.",
  "engines": {
    "node": ">=24"
  },
